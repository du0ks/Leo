rules_version = '2';

// NOTE: Firestore combines `allow` statements with OR. A broad
// `allow read, write: if isOwner()` therefore silently disables every
// validation rule next to it — so each operation below is granted exactly once.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Notes/notebooks require a verified email (the client enforces this too,
    // but the API key is public, so the rules must as well).
    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    function data() {
      return request.resource.data;
    }

    function validTitle() {
      return data().title is string && data().title.size() <= 200;
    }

    function validTimestampOrNull(field) {
      return !(field in data()) || data()[field] == null || data()[field] is timestamp;
    }

    // Default: deny everything not matched below
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile (settings). Created at sign-up, before email verification.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && data().keys().hasOnly(['email', 'displayName', 'createdAt', 'darkMode', 'themeColor', 'updatedAt'])
        && (!('darkMode' in data()) || data().darkMode is bool)
        && (!('themeColor' in data()) || (data().themeColor is string && data().themeColor.size() <= 20));
      allow delete: if false;

      match /notebooks/{notebookId} {
        allow read, delete: if isVerifiedOwner(userId);
        allow create, update: if isVerifiedOwner(userId)
          && data().keys().hasOnly(['title', 'parentNotebookId', 'createdAt', 'updatedAt', 'deletedAt'])
          && validTitle()
          && (data().get('parentNotebookId', null) == null
              || (data().parentNotebookId is string && data().parentNotebookId != notebookId))
          && validTimestampOrNull('deletedAt');

        match /notes/{noteId} {
          allow read, delete: if isVerifiedOwner(userId);
          allow create, update: if isVerifiedOwner(userId)
            && data().keys().hasOnly(['title', 'content', 'createdAt', 'updatedAt', 'deletedAt'])
            && validTitle()
            && (!('content' in data()) || data().content is list)
            && validTimestampOrNull('deletedAt');
        }
      }
    }
  }
}
